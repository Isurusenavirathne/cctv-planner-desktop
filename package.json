{
  "name": "cctv-network-planner",
  "version": "1.0.0",
  "description": "Pro Network & CCTV Planner - Desktop App",
  "main": "main.js",
  "author": "Isuru Senavirathne <your-email@example.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.cctvplanner",
    "productName": "CCTV Network Planner",
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}